From f71826c8b2089d165d38b6c26640c2e1e486b932 Mon Sep 17 00:00:00 2001
From: mihalera <88746771+mihalera@users.noreply.github.com>
Date: Tue, 27 Oct 2026 08:13:38 +0000
Subject: [PATCH 4/4] Draft releases open from a tag through the token Actions
 already has
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

GitHub hosts the repository and runs its CI, but nothing in the tree called its
API. The manual workflow names an existing tag, refuses to touch an existing
release, and opens a DRAFT with generated notes. It uploads no binaries and
never publishes: docs/release-checklist.md stays the gate, and attaching
artefacts is still a manual step.

GITHUB_TOKEN is the job's own token, requested as contents: write for the one
job that creates the draft, so no repository secret is created and no token
reaches the plugin.

🤖 Generated with Codebuff
Co-Authored-By: Codebuff <noreply@codebuff.com>
---
 .github/workflows/release-draft.yml | 66 +++++++++++++++++++++++++++++
 1 file changed, 66 insertions(+)
 create mode 100644 .github/workflows/release-draft.yml

diff --git a/.github/workflows/release-draft.yml b/.github/workflows/release-draft.yml
new file mode 100644
index 00000000..e9cfe843
--- /dev/null
+++ b/.github/workflows/release-draft.yml
@@ -0,0 +1,66 @@
+name: Draft GitHub release
+
+# GitHub already hosts this repository and runs its CI. This workflow is the
+# one place the project asks GitHub's API to WRITE something back: a maintainer
+# names an existing tag, and the run opens a DRAFT release with GitHub's
+# generated notes.
+#
+# It deliberately uploads no binaries and never publishes. docs/release-checklist.md
+# is the gate for that, and attaching artefacts stays a manual step after the
+# checklist is signed off. A draft release is a record, not a distribution.
+#
+# The token is the one GitHub Actions injects for the job (GITHUB_TOKEN). No
+# repository secret is created, and no token is compiled into the plugin or
+# written into the build.
+
+on:
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: "Existing tag to draft a release for (for example v1.0.0)"
+        required: true
+        type: string
+
+permissions:
+  contents: read
+
+concurrency:
+  group: draft-release-${{ inputs.tag }}
+  cancel-in-progress: false
+
+jobs:
+  draft:
+    name: Draft release for ${{ inputs.tag }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      contents: write
+
+    steps:
+      # If a release already exists, stop before touching it. Re-running the
+      # workflow is meant to be safe, not to rewrite notes somebody edited.
+      - name: Refuse to replace an existing release
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          TAG: ${{ inputs.tag }}
+        run: |
+          if gh release view "$TAG" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
+            echo "::error::A release for $TAG already exists. This workflow only creates the first draft."
+            exit 1
+          fi
+
+      # --verify-tag makes a typo fail here instead of creating a tag at the
+      # default branch's head. --generate-notes asks GitHub for the notes; the
+      # runner needs no checkout because the repository is named explicitly.
+      - name: Create the draft release
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          TAG: ${{ inputs.tag }}
+        run: |
+          gh release create "$TAG" \
+            --repo "$GITHUB_REPOSITORY" \
+            --draft \
+            --verify-tag \
+            --generate-notes \
+            --title "$TAG"
+          echo "Draft: $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/releases/tag/$TAG"
-- 
