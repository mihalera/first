# IDE / editor
.vs/
.vscode/
*.code-workspace
*.user
*.suo
*.userosscache
*.sln.docstates
*.vcxproj.user
*.VC.db
*.VC.VC.opendb

# Build outputs
#
# CMake builds out-of-source, so the whole tree is disposable and must never be
# committed. The generic names below catch a default `cmake -B build`, and the
# explicit `build/` entry catches the one the CI and the README use.
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake

# CPM's package cache. It holds downloaded third-party checkouts, so it is build
# input, not source - but unlike build/ it is meant to SURVIVE a wipe, which is
# what makes an offline configure possible. Never commit it: it is hundreds of
# megabytes of other people's repositories.
.cpm-cache/
_deps/
install_manifest.txt
*.ninja
compile_commands.json

x64/
x86/
Debug/
Release/
bin/
obj/
out/

# JUCE / plugin artifacts
#
# These patterns matter more than they look: a stray *.vst3/ or *.component/
# inside the checkout would be picked up by some hosts when scanning the repo,
# and a committed bundle is always a stale build.
*.dll
*.so
*.dylib
*.vst3/
*.component/
*.appex/
*.aaxplugin/
*.wav
*.mp3
*.flac

# Compiler / linker outputs
*.exp
*.lib
*.pdb
*.obj
*.o
*.a
*.pch
*.gch
*.idb
*.ipch
*.tlog
*.log
*.aps
*.ncb
*.opensdf
*.sdf
*.cache
*.ilk
*.db

# OS / misc
Thumbs.db
.DS_Store
Desktop.ini

# GitHub Actions artifacts
.github/workflows/*.local.yml

# Generated harness extraction - regenerated by tests/dsp/run.sh at build time.
tests/dsp/extracted_dsp.inc

# Python bytecode artifacts
__pycache__/
