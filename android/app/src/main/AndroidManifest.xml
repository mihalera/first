<?xml version="1.0" encoding="utf-8"?>
<!--
  `JuceApp` initialises the engine. The launcher is this app's own
  `MainActivity`, not JUCE's `JuceActivity`: the latter's onResume() calls a
  native `appOnResume` that JUCE only compiles when push notifications are
  enabled, so an APK using it installs and then dies on first resume with
  UnsatisfiedLinkError. See MainActivity.java for the whole story. The activity
  is the launcher because this APK is the plugin's Standalone wrapper, which
  has no host application to be loaded by.

  RECORD_AUDIO is requested because the Standalone wrapper asks for it before it
  opens an audio device with an input. If permission is denied, the app continues
  with output-only audio, including when restoring a saved device setup. The media
  permissions are the ones a file chooser needs on API levels before the Storage
  Access Framework applies; IR and .nam files are still picked through SAF, so
  none of them are required for the plugin to run.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Not required: the app must start and play on an output-only device
       when the user denies the microphone. -->
  <uses-feature android:name="android.hardware.microphone" android:required="false"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>

  <application
      android:name="com.rmsl.juce.JuceApp"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:hardwareAccelerated="false">

    <activity
        android:name="com.mcsmes.mibox.MainActivity"
        android:configChanges="orientation"
=======
        android:configChanges="keyboard|keyboardHidden|orientation|screenSize|navigation|smallestScreenSize|screenLayout|uiMode"
        android:launchMode="singleTask"
        android:hardwareAccelerated="true"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
